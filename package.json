  "bin": {
    "viby": "dist/cli.js"
  },
  "scripts": {
    "frameworks:generate": "node scripts/generate-framework-skills.mjs",
    "frameworks:check": "node scripts/generate-framework-skills.mjs --check",
    "build": "npm run frameworks:check && tsc -p tsconfig.build.json",
    "docs:build": "npm --prefix website run build",
    "docs:dev": "npm --prefix website run dev --",
    "docs:install": "npm ci --prefix website",
    "docs:typecheck": "npm --prefix website run typecheck",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit",
    "test:unit": "node --import tsx --test test/*.test.ts test/*.test.mjs",
    "test:integration": "node --import tsx --test test/postgres.integration.test.ts",
    "test:schema-upgrade": "node --import tsx --test test/schema-upgrade.integration.test.ts",
    "test:docker": "node --import tsx --test test/integration/sandbox-docker.test.ts",
    "test:playwright": "node --import tsx --test test/integration/browser-playwright.test.ts",
    "test:providers:live": "node --import tsx --test --test-concurrency=1 test/live/*.live.test.ts",
    "test:providers:cleanup": "node --import tsx scripts/cleanup-live-providers.ts",
    "test:package": "node scripts/package-smoke.mjs",
    "test:reference": "node --import tsx --test test/e2e/reference-app.test.mjs",
    "test:quality": "node --import tsx --test test/quality/*.test.ts",
    "test:compatibility": "tsc -p test/fixtures/api/tsconfig.json && node scripts/schema-fixtures.mjs && node scripts/api-compatibility.mjs",
    "test:runtime": "node scripts/runtime-compatibility.mjs",
    "check": "npm run typecheck && npm test && npm run test:quality && npm run build && npm run test:compatibility && npm run test:runtime",
    "bump": "bumpp",
    "release": "npm run release:latest",
    "release:auth": "npm whoami --registry=https://registry.npmjs.org",
    "release:latest": "npm run release:auth && bumpp && npm run publish:latest",
    "release:beta": "npm run release:auth && bumpp --preid beta && npm run publish:beta",
    "release:canary": "npm run release:auth && bumpp --preid canary && npm run publish:canary",
    "release:check": "node scripts/check-release-version.mjs && npm run check && npm run test:package",
    "release:prepare": "node scripts/check-release-branch.mjs && npm run release:check && npm run release:guard",
    "release:guard": "node scripts/release-guard.mjs",
    "publish:dry-run": "npm run release:check && npm publish --dry-run --ignore-scripts --access public --tag latest",
    "publish:latest": "npm publish --access public --tag latest",
    "publish:beta": "npm publish --access public --tag beta",
    "publish:canary": "npm publish --access public --tag canary",
    "prepack": "npm run build",
    "prepublishOnly": "npm run release:check"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "dependencies": {
    "@noble/hashes": "^1.8.0",
    "ai": "^7.0.52",
    "fflate": "^0.8.3",
    "postgres": "^3.4.9",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@aws-sdk/client-s3": "^3.1108.0",
    "@axe-core/playwright": "^4.12.1",
    "@cloudflare/sandbox": "^0.12.5",
    "@daytona/sdk": "^0.203.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@modelcontextprotocol/client": "^2.0.0",
    "@vercel/sandbox": "^3.0.0",
    "e2b": "^2.38.2",
    "modal": "^0.9.0",
    "playwright": "^1.62.1"
  },
