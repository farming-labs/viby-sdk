{
  "name": "@viby/sdk",
  "version": "0.2.4",
  "description": "Framework-agnostic SDK for building persistent, skill-guided vibe coding products.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/farming-labs/viby-sdk.git"
  },
  "homepage": "https://github.com/farming-labs/viby-sdk#readme",
  "bugs": {
    "url": "https://github.com/farming-labs/viby-sdk/issues"
  },
  "keywords": [
    "ai",
    "code-generation",
    "sdk",
    "skills",
    "typescript",
    "vibe-coding"
  ],
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "docs",
    "migrations",
    "README.md",
    "RELEASING.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./sandbox/e2b": {
      "types": "./dist/sandbox-e2b.d.ts",
      "import": "./dist/sandbox-e2b.js"
    },
    "./sandbox/vercel": {
      "types": "./dist/sandbox-vercel.d.ts",
      "import": "./dist/sandbox-vercel.js"
    },
    "./sandbox/docker": {
      "types": "./dist/sandbox-docker.d.ts",
      "import": "./dist/sandbox-docker.js"
    },
    "./sandbox/daytona": {
      "types": "./dist/sandbox-daytona.d.ts",
      "import": "./dist/sandbox-daytona.js"
    },
    "./sandbox/modal": {
      "types": "./dist/sandbox-modal.d.ts",
      "import": "./dist/sandbox-modal.js"
    },
    "./sandbox/cloudflare": {
      "types": "./dist/sandbox-cloudflare.d.ts",
      "import": "./dist/sandbox-cloudflare.js"
    },
    "./sandbox/conformance": {
      "types": "./dist/sandbox-conformance.d.ts",
      "import": "./dist/sandbox-conformance.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "viby": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit",
    "test:unit": "node --import tsx --test test/*.test.ts test/*.test.mjs",
    "test:integration": "node --import tsx --test test/postgres.integration.test.ts",
    "test:docker": "node --import tsx --test test/integration/sandbox-docker.test.ts",
    "test:package": "node scripts/package-smoke.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "bump": "bumpp",
    "release": "npm run release:latest",
    "release:auth": "npm whoami --registry=https://registry.npmjs.org",
    "release:latest": "npm run release:auth && bumpp && npm run publish:latest",
    "release:beta": "npm run release:auth && bumpp --preid beta && npm run publish:beta",
    "release:canary": "npm run release:auth && bumpp --preid canary && npm run publish:canary",
    "release:check": "node scripts/check-release-version.mjs && npm run check && npm run test:package",
    "release:prepare": "node scripts/check-release-branch.mjs && npm run release:check && npm run release:guard",
    "release:guard": "node scripts/release-guard.mjs",
    "publish:dry-run": "npm run release:check && npm publish --dry-run --ignore-scripts --access public --tag latest",
    "publish:latest": "npm publish --access public --tag latest",
    "publish:beta": "npm publish --access public --tag beta",
    "publish:canary": "npm publish --access public --tag canary",
    "prepack": "npm run build",
    "prepublishOnly": "npm run release:check"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "dependencies": {
    "ai": "^7.0.52",
    "fflate": "^0.8.3",
    "postgres": "^3.4.9",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@cloudflare/sandbox": "^0.12.5",
    "@daytona/sdk": "^0.203.0",
    "@vercel/sandbox": "^3.0.0",
    "e2b": "^2.38.2",
    "modal": "^0.9.0"
  },
  "peerDependenciesMeta": {
    "@cloudflare/sandbox": {
      "optional": true
    },
    "@daytona/sdk": {
      "optional": true
    },
    "@vercel/sandbox": {
      "optional": true
    },
    "e2b": {
      "optional": true
    },
    "modal": {
      "optional": true
    }
  },
  "devDependencies": {
    "@cloudflare/sandbox": "^0.12.5",
    "@daytona/sdk": "^0.203.0",
    "@types/node": "^26.1.2",
    "@vercel/sandbox": "^3.0.0",
    "bumpp": "^10.4.1",
    "e2b": "^2.38.2",
    "modal": "^0.9.0",
    "tsx": "^4.23.7",
    "typescript": "^7.0.2"
  }
}
