{
  "name": "@viby/sdk",
  "version": "0.2.2",
  "description": "Framework-agnostic SDK for building persistent, skill-guided vibe coding products.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/farming-labs/viby-sdk.git"
  },
  "homepage": "https://github.com/farming-labs/viby-sdk#readme",
  "bugs": {
    "url": "https://github.com/farming-labs/viby-sdk/issues"
  },
  "keywords": [
    "ai",
    "code-generation",
    "sdk",
    "skills",
    "typescript",
    "vibe-coding"
  ],
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "docs",
    "migrations",
    "README.md",
    "RELEASING.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "viby": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit",
    "test:unit": "node --import tsx --test test/*.test.ts test/*.test.mjs",
    "test:integration": "node --import tsx --test test/postgres.integration.test.ts",
    "test:package": "node scripts/package-smoke.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "bump": "bumpp",
    "release": "npm run release:latest",
    "release:latest": "bumpp",
    "release:beta": "bumpp --preid beta",
    "release:canary": "bumpp --preid canary",
    "release:check": "node scripts/check-release-version.mjs && npm run check && npm run test:package",
    "release:prepare": "node scripts/check-release-branch.mjs && npm run release:check",
    "release:guard": "node scripts/release-guard.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm run release:check"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org"
  },
  "dependencies": {
    "ai": "^7.0.52",
    "fflate": "^0.8.3",
    "postgres": "^3.4.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "bumpp": "^10.4.1",
    "tsx": "^4.23.7",
    "typescript": "^7.0.2"
  }
}
