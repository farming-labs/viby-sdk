  "types": "./dist/index.d.ts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/farming-labs/viby-sdk.git"
  },
  "homepage": "https://github.com/farming-labs/viby-sdk#readme",
