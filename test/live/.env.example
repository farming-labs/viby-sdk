VIBY_LIVE_PROVIDER_TESTS=1
VIBY_LIVE_PROVIDERS=github

# GitHub App installation
VIBY_LIVE_GITHUB_APP_ID=
VIBY_LIVE_GITHUB_APP_PRIVATE_KEY=
VIBY_LIVE_GITHUB_INSTALLATION_ID=
VIBY_LIVE_GITHUB_OWNER=
# organization (default) or user
VIBY_LIVE_GITHUB_ACCOUNT_KIND=organization
# Required only when testing a user-owned installation.
VIBY_LIVE_GITHUB_USER_TOKEN=
# VIBY_LIVE_GITHUB_API_URL=https://api.github.com

# Vercel external-integration credential
VIBY_LIVE_VERCEL_ACCESS_TOKEN=
VIBY_LIVE_VERCEL_TEAM_ID=
VIBY_LIVE_VERCEL_PROJECT_ID=
# VIBY_LIVE_VERCEL_API_URL=https://api.vercel.com

# Cloudflare OAuth credential. Use either a current access token or a refresh
# token together with the OAuth client credentials.
VIBY_LIVE_CLOUDFLARE_ACCOUNT_ID=
VIBY_LIVE_CLOUDFLARE_ACCESS_TOKEN=
VIBY_LIVE_CLOUDFLARE_REFRESH_TOKEN=
VIBY_LIVE_CLOUDFLARE_CLIENT_ID=
VIBY_LIVE_CLOUDFLARE_CLIENT_SECRET=
# VIBY_LIVE_CLOUDFLARE_API_URL=https://api.cloudflare.com/client/v4

# Bitbucket OAuth credential. Use either a current access token or a refresh
# token together with the OAuth consumer credentials.
VIBY_LIVE_BITBUCKET_WORKSPACE=
VIBY_LIVE_BITBUCKET_ACCESS_TOKEN=
VIBY_LIVE_BITBUCKET_REFRESH_TOKEN=
VIBY_LIVE_BITBUCKET_CLIENT_ID=
VIBY_LIVE_BITBUCKET_CLIENT_SECRET=
# VIBY_LIVE_BITBUCKET_API_URL=https://api.bitbucket.org/2.0
# Packaged Codex coding-agent verification. Authentication comes from the
# local Codex installation unless codex({ apiKey }) is configured explicitly.
VIBY_LIVE_CODEX_AGENT=0
VIBY_CODEX_MODEL=gpt-5.6-sol
